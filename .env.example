# Optional. Leave unset to use the embedded PGlite database stored in ./.pglite
# (what `pnpm dev` and `pnpm db:seed` use on a fresh clone). Set it to a
# Postgres connection string (e.g. Supabase) to use postgres-js instead.
DATABASE_URL=

# Guild name shown as the wordmark in the header. Defaults to "Elite Ledger".
NEXT_PUBLIC_GUILD_NAME=

# Claude API key for the Extractor (screenshot -> rows). Not needed for tests or `pnpm eval:extractor --mock`.
ANTHROPIC_API_KEY=
# Model the Extractor calls. Defaults to claude-opus-5.
EXTRACTOR_MODEL=
# Extractor effort: low | medium | high | xhigh | max. Unset = API default.
EXTRACTOR_EFFORT=
# Enlarge small screenshots (Lanczos, up to 2x) before sending them: on | off. Unset = on.
EXTRACTOR_UPSCALE=
# Longest edge in px of the enlarged image. Unset = 1568; claude-opus-5 also accepts 2576 (more image tokens).
EXTRACTOR_UPSCALE_MAX_EDGE=
# Server-side refusal fallbacks: on | off. Unset = on for claude-opus-5, off for other models.
EXTRACTOR_FALLBACKS=

# Passcode for the /try playground (header x-try-passcode). Required when deployed: on Vercel the playground is off without it. Unset locally = open.
TRY_PASSCODE=

# Passcode for the admin area (/admin, header x-admin-passcode). Separate from TRY_PASSCODE. Required when deployed: on Vercel the admin API answers 503 without it. Unset locally = open. Goes away once Discord login (#4) exists.
ADMIN_PASSCODE=

# Public Google Sheet the Upload page links to (rows are pasted there until the site saves them itself).
NEXT_PUBLIC_SHEET_URL=
