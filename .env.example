# Optional. Leave unset to use the embedded PGlite database stored in ./.pglite
# (what `pnpm dev` and `pnpm db:seed` use on a fresh clone). Set it to a
# Postgres connection string (e.g. Supabase) to use postgres-js instead.
DATABASE_URL=

# Guild name shown as the wordmark in the header. Defaults to "Elite Ledger".
NEXT_PUBLIC_GUILD_NAME=

# Claude API key for the Extractor (screenshot -> rows). Not needed for tests or `pnpm eval:extractor --mock`.
ANTHROPIC_API_KEY=
# Model the Extractor calls. Defaults to claude-opus-5.
EXTRACTOR_MODEL=
# Extractor effort: low | medium | high | xhigh | max. Unset = API default.
EXTRACTOR_EFFORT=
# Server-side refusal fallbacks: on | off. Unset = on for claude-opus-5, off for other models.
EXTRACTOR_FALLBACKS=
